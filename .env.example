# Single .env for the whole monorepo — copy to .env at the repo root.

# Optional — defaults to packages/db/prisma/dev.db.
# Override with an absolute file: URL (e.g. the litestream-replicated file in prod).
# DATABASE_URL="file:/var/data/fde.db"

# Comma-separated emails seeded by `prisma db seed` (default: test@paramify.com).
# The first email becomes a super user and joins both fixture teams.
# USERS="alice@paramify.com,bob@paramify.com"
# "0" makes the seed skip the sample deliverables (used by the e2e flow test).
# SEED_SAMPLES="1"

# Deliverable file storage. Only 'local' is implemented (S3 later).
# STORAGE_PROVIDER="local"
# Root dir for the local provider (default: <repo>/.storage).
# STORAGE_DIR="/var/data/fde-storage"

# Paramify instance validators sync to (`fde paramify …`). Unset disables the
# sync endpoints. No workspace id is needed: each team's Paramify API key
# (set with `fde teams set-key`) is bound to its workspace.
# PARAMIFY_URL="https://app.paramify.com"
